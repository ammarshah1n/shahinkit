{
  "adapter": "opencode",
  "receipt_schema": "claude-code/core/docs/INSTALL-RECEIPT-SCHEMA.md",
  "opencode_version": "1.17.20",
  "render_rules": {
    "copy": "Copy bytes from source to destination. Never symlink.",
    "activation": "Plugin registration and Ponytail/Caveman lifecycle activate only after preview, apply, and host-trust confirmation.",
    "scope_roots": {
      "user": {
        "instructions": "AGENTS.md",
        "config": "opencode.jsonc",
        "agents": "agents",
        "commands": "commands",
        "skills": "skills",
        "plugins": "plugins"
      },
      "project": {
        "instructions": "AGENTS.md",
        "config": "opencode.jsonc",
        "agents": ".opencode/agents",
        "commands": ".opencode/commands",
        "skills": ".opencode/skills",
        "plugins": ".opencode/plugins"
      }
    }
  },
  "scope_examples": {
    "user": "opencode.user.jsonc.example",
    "project": "opencode.jsonc.example"
  },
  "render": {
    "byte_copy": [
      "opencode/.opencode/plugins/portable-gates.mjs"
    ],
    "templates": [
      "opencode/AGENTS.md",
      "opencode/.opencode/plugins/portable-gates.features.mjs",
      "opencode/opencode.user.jsonc.example",
      "opencode/opencode.jsonc.example"
    ],
    "scope_templates": {
      "user": {
        "config": "opencode/opencode.user.jsonc.example",
        "config_destination": "opencode.jsonc",
        "agents": "opencode/AGENTS.md",
        "plugin_features": "opencode/.opencode/plugins/portable-gates.features.mjs",
        "plugin_destination": "plugins/portable-gates.features.mjs"
      },
      "project": {
        "config": "opencode/opencode.jsonc.example",
        "config_destination": "opencode.jsonc",
        "agents": "opencode/AGENTS.md",
        "plugin_features": "opencode/.opencode/plugins/portable-gates.features.mjs",
        "plugin_destination": ".opencode/plugins/portable-gates.features.mjs"
      }
    },
    "required_substitutions": [
      "SHAHINKIT_DATA_DIR",
      "SHAHINKIT_STATE_DIR",
      "LOCAL_BASIC_MEMORY_CONFIG_DIR",
      "LOCAL_PROJECT_NAME",
      "LOCAL_PROJECT_PATH",
      "LOCAL_PROJECT_ROOT",
      "PONYTAIL_ENABLED",
      "CAVEMAN_ENABLED",
      "BUDGET_PRESET",
      "DELEGATION_MODE",
      "INLINE_FILE_LIMIT",
      "INLINE_LINE_LIMIT",
      "ROLE_MODEL_CONTROLLER",
      "ROLE_MODEL_RESEARCH",
      "ROLE_MODEL_IMPLEMENTATION",
      "ROLE_MODEL_REVIEW",
      "ROLE_MODEL_MECHANICAL",
      "CROSS_HOST_ROUTE"
    ],
    "default_substitutions": {
      "PONYTAIL_ENABLED": "true",
      "CAVEMAN_ENABLED": "true"
    }
  },
  "context_renders": [
    {
      "source": "claude-code/core/shared/context/core-policy.block.md",
      "destination": "AGENTS.md",
      "marker": "CORE-POLICY"
    },
    {
      "source": "claude-code/core/shared/context/ponytail-default.block.md",
      "destination": "AGENTS.md",
      "marker": "PONYTAIL"
    },
    {
      "source": "claude-code/core/shared/context/caveman-default.block.md",
      "destination": "AGENTS.md",
      "marker": "CAVEMAN"
    },
    {
      "source": "claude-code/core/shared/context/explain-mode.block.md",
      "destination": "AGENTS.md",
      "marker": "EXPLAIN-MODE"
    },
    {
      "source": "claude-code/core/shared/context/delegation-budget.block.md",
      "destination": "AGENTS.md",
      "marker": "DELEGATION-BUDGET"
    },
    {
      "source": "claude-code/core/shared/context/adapter-references.block.md",
      "destination": "AGENTS.md",
      "marker": "ADAPTER-REFERENCES"
    }
  ],
  "shared_skills": [
    "audit-tool",
    "checkpoint",
    "collab",
    "context-router",
    "corrections",
    "deep-idea",
    "deep-plan",
    "delegation-routing",
    "graphify",
    "idea",
    "memory",
    "miniwrap",
    "mission",
    "onboard",
    "output-style",
    "parallel-worktrees",
    "plan",
    "plans",
    "prime",
    "reflect",
    "research",
    "self-improve",
    "session-handoff",
    "skill-builder",
    "study",
    "taste-gate",
    "triage",
    "watch",
    "wrap-up"
  ],
  "shared_memory": [
    "CORRECTIONS.md",
    "HANDOFF.md",
    "LEARNINGS.md",
    "NEXT.md",
    "PROJECT_STATE.md"
  ],
  "vendor_skills": {
    "ponytail": [
      "ponytail",
      "ponytail-audit",
      "ponytail-debt",
      "ponytail-gain",
      "ponytail-help",
      "ponytail-review"
    ],
    "caveman": [
      "caveman",
      "caveman-commit",
      "caveman-help",
      "caveman-review"
    ]
  },
  "mcp_templates": [
    "claude-code/core/shared/mcp/basic-memory/opencode.mcp.json",
    "claude-code/core/shared/mcp/basic-memory/local-config.example.json"
  ],
  "course_rag": {
    "data_destination": "{{SHAHINKIT_DATA_DIR}}/course-rag",
    "skill_destinations": {
      "user": "skills/course-rag/SKILL.md",
      "project": ".opencode/skills/course-rag/SKILL.md"
    },
    "outputs": [
      {
        "source": "claude-code/skills/course-rag/SKILL.md",
        "destinations": {
          "user": "skills/course-rag/SKILL.md",
          "project": ".opencode/skills/course-rag/SKILL.md"
        }
      },
      {
        "source": "claude-code/course-rag/README.md",
        "destination": "{{SHAHINKIT_DATA_DIR}}/course-rag/README.md"
      },
      {
        "source": "claude-code/course-rag/scripts/build.py",
        "destination": "{{SHAHINKIT_DATA_DIR}}/course-rag/scripts/build.py"
      },
      {
        "source": "claude-code/course-rag/scripts/search.py",
        "destination": "{{SHAHINKIT_DATA_DIR}}/course-rag/scripts/search.py"
      },
      {
        "source": "claude-code/course-rag/indexes/.gitignore",
        "destination": "{{SHAHINKIT_DATA_DIR}}/course-rag/.gitignore"
      },
      {
        "source": "claude-code/course-rag/indexes/.gitkeep",
        "destination": "{{SHAHINKIT_DATA_DIR}}/course-rag/.gitkeep"
      }
    ]
  },
  "adapter_assets": [
    "AGENTS.md",
    "opencode.jsonc.example",
    "opencode.user.jsonc.example",
    ".opencode/plugins/portable-gates.mjs",
    ".opencode/plugins/portable-gates.features.mjs",
    ".opencode/plugins/shahinkit-guard.mjs",
    ".opencode/agents/controller.md",
    ".opencode/agents/research.md",
    ".opencode/agents/implementation.md",
    ".opencode/agents/review.md",
    ".opencode/agents/mechanical.md",
    ".opencode/commands/prime.md",
    ".opencode/commands/plan.md",
    ".opencode/commands/study.md",
    ".opencode/commands/wrap-up.md",
    ".opencode/commands/ponytail.md",
    ".opencode/commands/caveman.md"
  ],
  "required_install_assets": [
    "AGENTS.md",
    "opencode.jsonc.example",
    "opencode.user.jsonc.example",
    ".opencode/plugins/portable-gates.mjs",
    ".opencode/plugins/portable-gates.features.mjs",
    ".opencode/plugins/shahinkit-guard.mjs",
    ".opencode/agents/controller.md"
  ],
  "install_destinations": {
    "AGENTS.md": "AGENTS.md",
    "opencode.jsonc.example": "opencode.jsonc",
    "opencode.user.jsonc.example": "opencode.jsonc",
    ".opencode/plugins/portable-gates.mjs": "plugins/portable-gates.mjs",
    ".opencode/plugins/portable-gates.features.mjs": "plugins/portable-gates.features.mjs",
    ".opencode/plugins/shahinkit-guard.mjs": "plugins/shahinkit-guard.mjs",
    ".opencode/agents/controller.md": "agents/controller.md"
  },
  "vendor_file_mappings": [
    {
      "source_root": "claude-code/core/third_party/swift-testing/skills/swift-testing-pro",
      "skill": "swift-testing-pro",
      "files": [
        "SKILL.md",
        "LICENSE",
        "references/async-tests.md",
        "references/core-rules.md",
        "references/migrating-from-xctest.md",
        "references/new-features.md",
        "references/writing-better-tests.md"
      ]
    },
    {
      "source_root": "claude-code/core/third_party/swiftdata/skills/swiftdata-pro",
      "skill": "swiftdata-pro",
      "files": [
        "SKILL.md",
        "LICENSE",
        "references/class-inheritance.md",
        "references/cloudkit.md",
        "references/core-rules.md",
        "references/indexing.md",
        "references/predicates.md"
      ]
    },
    {
      "source_root": "claude-code/core/third_party/swiftui/skills/swiftui-pro",
      "skill": "swiftui-pro",
      "files": [
        "SKILL.md",
        "LICENSE",
        "references/accessibility.md",
        "references/api.md",
        "references/data.md",
        "references/design.md",
        "references/hygiene.md",
        "references/navigation.md",
        "references/performance.md",
        "references/swift.md",
        "references/views.md"
      ]
    }
  ]
}
