{
  "description": "Example Codex hook manifest. Disabled until copied into a project and reviewed.",
  "enabled": false,
  "hooks": [
    {
      "event": "session_start",
      "command": "echo 'Run prime before non-trivial work.'",
      "writesByDefault": false
    },
    {
      "event": "session_stop",
      "command": "echo 'Run wrap-up before closing meaningful work.'",
      "writesByDefault": false
    }
  ]
}
