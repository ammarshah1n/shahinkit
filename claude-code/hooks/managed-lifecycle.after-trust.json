{
  "installer_managed": true,
  "activation": {
    "required": ["preview", "apply", "trust-host"],
    "default_enabled": true,
    "host_reload_required": true,
    "fresh_session_required": false
  },
  "hooks": {
    "SessionStart": "Prime guidance only",
    "UserPromptSubmit": "Caveman restatement only; reads event cwd for opt-out matching, never the prompt text",
    "SubagentStart": "bounded-worker guidance only",
    "filesystem_writes": false,
    "telemetry": false,
    "prompt_retention": false
  },
  "modes": {
    "ponytail": {
      "enabled": true,
      "default": "full",
      "opt_out": "--without-ponytail",
      "delivery": "rendered-static-context-and-approved-skills",
      "hook_registration": "none"
    },
    "caveman": {
      "enabled": true,
      "default": "full",
      "opt_out": "--without-caveman",
      "delivery": "rendered-static-context, explicit commands, and per-turn restatement",
      "hook_registration": "UserPromptSubmit",
      "hook_rationale": "Static instruction context decays over a long session. The restatement is advisory additionalContext only."
    }
  },
  "path_opt_out": {
    "file": ".shahinkit-data/hook-config.json",
    "key": "opt_out_paths",
    "effect": "Suppresses all ShahinKit lifecycle context when the event cwd is at or under a listed path.",
    "user_editable": true
  },
  "prohibited": [
    "permission bypass",
    "prompt inspection",
    "event payload retention",
    "automatic writes",
    "automatic commits",
    "automatic pushes",
    "remote updater"
  ]
}
