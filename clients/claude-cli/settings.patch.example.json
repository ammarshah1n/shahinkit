{
  "description": "Example Claude Code settings fragment. Merge manually after reviewing paths and commands.",
  "shahinkit": {
    "enabled": false,
    "sharedRoot": "{{SHAHINKIT_SHARED_ROOT}}",
    "projectRoot": "{{PROJECT_ROOT}}"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PROJECT_ROOT}}/shared/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PROJECT_ROOT}}/shared/hooks/precompact-snapshot.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PROJECT_ROOT}}/shared/hooks/post-session-export.sh"
          }
        ]
      }
    ]
  }
}
