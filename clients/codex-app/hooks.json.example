{
  "description": "Example ShahinKit hook wiring for clients that support JSON hook manifests.",
  "enabled": false,
  "projectRoot": "{{PROJECT_ROOT}}",
  "hooks": [
    {
      "event": "session_start",
      "command": "{{PROJECT_ROOT}}/shared/hooks/session-start.sh",
      "writesByDefault": false
    },
    {
      "event": "pre_compact",
      "command": "{{PROJECT_ROOT}}/shared/hooks/precompact-snapshot.sh",
      "writesByDefault": false,
      "enableWith": "SHAHINKIT_WRITE_SNAPSHOT=1"
    },
    {
      "event": "session_stop",
      "command": "{{PROJECT_ROOT}}/shared/hooks/post-session-export.sh",
      "writesByDefault": false,
      "enableWith": "SHAHINKIT_EXPORT_TRANSCRIPT=1"
    }
  ]
}
