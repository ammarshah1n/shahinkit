#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command_name="${1:-help}"

usage() {
  cat <<'USAGE'
Usage:
  bin/shahinkit <command> [args]

Commands:
  doctor       Check required local tools and kit layout
  render       Render a client adapter package
  install      Preview or install a rendered client package
  show-layout  Print the repository layout
  deep-idea    Print the deep-idea skill path
  new-idea     Print the new-idea skill path
  deep-plan    Print the deep-plan skill path
  skill-builder  Print the skill-builder skill path
  wrap-up      Print the wrap-up skill path
USAGE
}

case "${command_name}" in
  doctor)
    shift
    exec "${repo_root}/scripts/doctor.sh" "$@"
    ;;
  render)
    shift
    exec "${repo_root}/scripts/render-client-config.sh" "$@"
    ;;
  install)
    shift
    exec "${repo_root}/scripts/install.sh" "$@"
    ;;
  show-layout)
    find "${repo_root}" -maxdepth 3 -type d -not -path "${repo_root}/.git*" | sort
    ;;
  deep-idea)
    printf '%s\n' "${repo_root}/shared/skills/deep-idea/SKILL.md"
    ;;
  new-idea)
    printf '%s\n' "${repo_root}/shared/skills/new-idea/SKILL.md"
    ;;
  deep-plan)
    printf '%s\n' "${repo_root}/shared/skills/deep-plan/SKILL.md"
    ;;
  skill-builder)
    printf '%s\n' "${repo_root}/shared/skills/skill-builder/SKILL.md"
    ;;
  wrap-up)
    printf '%s\n' "${repo_root}/shared/skills/wrap-up/SKILL.md"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'unknown command: %s\n' "${command_name}" >&2
    usage >&2
    exit 2
    ;;
esac
